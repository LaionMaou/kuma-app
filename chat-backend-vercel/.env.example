# Puerto de desarrollo local (opcional)
PORT=3001

# Clave de moderación / Cabina DJ (opcional, para borrar mensajes)
DJ_MODERATION_KEY=KUMA-DJ-2025

# Persistencia Opcional con Upstash Redis / Vercel KV:
# Si dejas estas variables vacías, el backend usará almacenamiento en memoria.
# Si agregas una base de datos Redis gratuita de Upstash en Vercel, los mensajes se guardarán permanentemente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
